# Google Gemini API Key for Live AI Moderation, Seed Suggester & Consensus Reporting
# (If omitted, system uses built-in heuristic mediator & reporter)
GEMINI_API_KEY=

# Supabase Cloud Database Credentials (Optional - system falls back to SQLite / in-memory Wasm)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server Port (default 3001)
PORT=3001
